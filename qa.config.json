{
  "version": 1,
  "target": {
    "path": "C:\\Users\\dopem\\Documents\\RCR\\software\\backend\\RideCityRentals-backend\\functions",
    "name": "functions"
  },
  "ai": {
    "provider": "anthropic",
    "model": "claude-opus-4-8",
    "apiKeyEnv": "ANTHROPIC_API_KEY",
    "effort": "high",
    "maxOutputTokens": 8000
  },
  "run": {
    "agents": [
